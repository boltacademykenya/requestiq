# ---------------------------------------------------------------------------
# ReorderIQ environment
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the app, migrations and scripts.
#
# TLS is configured here rather than by a separate variable, because
# node-postgres merges the parsed connection string over the pool options: an
# `ssl` object sourced from the environment would be silently ignored whenever
# this URL carries an `sslmode`. For managed Postgres add `?sslmode=verify-full`.
# Prefer that over `require`, which stops verifying the certificate in
# pg-connection-string v3 / pg v9. A local server needs no `sslmode` at all.
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=verify-full
DATABASE_URL=postgres://postgres:1234@localhost:5432/reorderiq

# Session signing secret: 32+ random bytes. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this app; also the primary trusted origin.
BETTER_AUTH_URL=http://localhost:3001
# Extra comma separated origins allowed to call the API (staging domains, etc.)
AUTH_TRUSTED_ORIGINS=

# Pepper for hashing request IPs in rate limits and the audit trail.
# Falls back to BETTER_AUTH_SECRET when unset.
IP_HASH_SECRET=

# Comma separated emails allowed to use the platform (staff) surface, currently
# the inbound contact-form leads inbox at /admin/leads and
# /api/v1/platform/leads. Leave empty to disable that surface entirely.
#   PLATFORM_ADMIN_EMAILS=ops@reorderiq.co.ke,founder@reorderiq.co.ke
PLATFORM_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Data connectors (see docs/INTEGRATIONS.md)
# ---------------------------------------------------------------------------

# Root key for sealing tenant connector credentials (AES-256-GCM). 32+ random
# bytes. Leave empty to disable credential storage entirely: nothing is written
# in plaintext and any sync that needs a credential fails closed.
# Rotating this value invalidates stored credentials — operators re-enter them.
#   INTEGRATION_SECRET_KEY=<openssl rand -base64 32>
INTEGRATION_SECRET_KEY=

# Allow connectors to reach private/link-local addresses. Only for a source on
# your own network (an on-premise ERP, a local Zoho). Leaving this false is what
# stops a tenant pointing the server at its own internal services.
INTEGRATION_ALLOW_PRIVATE_NETWORKS=false

# Shared secret for the scheduled-sync entrypoint. Send it as `x-cron-secret` to
# POST /api/v1/integrations/sync-due from cron (every 15 minutes is plenty).
# Empty disables the endpoint.
#   SYNC_CRON_SECRET=<openssl rand -base64 24>
SYNC_CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional third-party providers (not required to run the app)
# ---------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_ORGANIZATION_ID=
WHATSAPP_API_TOKEN=
SMS_API_KEY=

